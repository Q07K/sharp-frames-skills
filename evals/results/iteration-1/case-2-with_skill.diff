import unittest

from shop.orders import OrderStore, place_order
from shop.pricing import Line
from shop.wholesale import shipping_fee_won


class WholesalePolicyTests(unittest.TestCase):
    def test_paid_and_free_shipping_boundaries(self):
        for subtotal, expected in [
            (0, 6_000), (99_999, 6_000), (100_000, 6_000),
            (119_999, 6_000), (120_000, 0), (120_001, 0),
        ]:
            with self.subTest(subtotal=subtotal):
                self.assertEqual(shipping_fee_won(subtotal), expected)

    def test_invalid_subtotal_contract_is_preserved(self):
        for subtotal in [-1, True, False, 100_000.0, "120000", None]:
            with self.subTest(subtotal=subtotal):
                with self.assertRaisesRegex(ValueError, "^invalid subtotal$"):
                    shipping_fee_won(subtotal)

    def test_retail_order_policy_is_unchanged(self):
        for price, member, coupon, expected in [
            (49_999, "regular", False, (0, 3_000, 52_999)),
            (50_000, "regular", False, (0, 0, 50_000)),
            (60_000, "vip", True, (11_000, 3_000, 52_000)),
            (4_000, "regular", True, (4_000, 3_000, 3_000)),
        ]:
            with self.subTest(price=price, member=member, coupon=coupon):
                store = OrderStore()
                order = place_order(store, [Line(price, 1)], member, coupon)
                self.assertEqual(order, {
                    "id": 1, "subtotal_won": price, "discount_won": expected[0],
                    "shipping_won": expected[1], "total_won": expected[2],
                })
                self.assertEqual(len(store.orders), 1)
